<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Ficciones Futuras — 2021</title>

  <style>
    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      background: #8FD8D5;
      color: #fff;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 18px;
      line-height: 1.45;
    }

    main {
      width: min(1100px, calc(100% - 80px));
      margin: 0 auto;
      padding: 70px 0 120px;
    }

    /* TÍTULO */

    header {
      margin-bottom: 80px;
    }

    .title {
      font-size: clamp(70px, 12vw, 160px);
      line-height: 0.9;
      font-weight: 700;
      letter-spacing: -0.065em;
      margin: 0;
    }

    /* BARRA DE NAVEGACIÓN */

    .nav {
      position: sticky;
      top: 0;
      background: #f5f5f2;
      padding: 20px 0;
      margin-bottom: 100px;
      z-index: 10;
    }

    .nav a {
      color: inherit;
      text-decoration: none;
      margin-right: 35px;
      font-size: 14px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .nav a:hover {
      text-decoration: underline;
    }

    /* SECCIONES */

    section {
      max-width: 850px;
      margin-bottom: 180px;
      scroll-margin-top: 80px;
    }

    .section-title {
      font-size: 14px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 30px;
    }

    /* CELULAR */

    @media (max-width: 700px) {
      body {
        font-size: 16px;
      }

      main {
        width: calc(100% - 40px);
        padding-top: 35px;
      }

      header {
        margin-bottom: 60px;
      }

      .nav {
        padding: 15px 0;
        margin-bottom: 70px;
      }

      .nav a {
        margin-right: 18px;
        font-size: 12px;
      }

      section {
        margin-bottom: 120px;
      }
    }
  </style>
</head>

<body>

  <main>

    <header>
      <h1 class="title">2021</h1>
    </header>

    <nav class="nav">
      <a href="#consigna">Consigna</a>
      <a href="#referentes">Referentes</a>
      <a href="#agentes">Agentes</a>
      <a href="#trabajos">Trabajos</a>
    </nav>

    <section id="consigna">
      <div class="section-title">Consigna</div>

      <p>
        Acá va el contenido de la consigna 2021.
      </p>
    </section>

    <section id="referentes">
      <div class="section-title">Referentes</div>

      <p>
        Acá van los referentes de 2021.
      </p>
    </section>

    <section id="agentes">
      <div class="section-title">Agentes</div>

      <p>
        Acá van los agentes de 2021.
      </p>
    </section>

    <section id="trabajos">
      <div class="section-title">Trabajos</div>

      <p>
        Acá van los trabajos de 2021.
      </p>
    </section>

  </main>

</body>
</html>
